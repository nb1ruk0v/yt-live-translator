# Required when diarization is enabled in config.yaml.
# Get token: https://huggingface.co/settings/tokens
# Accept conditions on:
#   - https://huggingface.co/pyannote/segmentation-3.0
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=hf_...

# Used by run_remote.sh to ship the pipeline to a GPU server.
# REMOTE_HOST is required; the others have defaults.
REMOTE_HOST=user@gpu-host
REMOTE_DIR=~/vt-claude
# VT_DATA_LOCAL=data
